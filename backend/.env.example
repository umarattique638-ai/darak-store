NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────
MONGO_URL=
MONGO_DB_NAME=darak_store

# ── JWT (seconds) ────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
OTP_SECRET=
OTP_TTL_MINUTES=

# ── Storefront ───────────────────────────────────────────
# local: http://localhost:3000   ·   live: your Vercel storefront URL
CLIENT_URL=http://localhost:3000

# ── Email (OTP codes, order confirmations, admin alerts) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ORDER_NOTIFY_EMAILS=
LEAD_NOTIFY_EMAILS=

# ── Cloudinary (product & design images) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
UPLOAD_MAX_MB=

# ── Store ───────────────────────────────────────────────
CURRENCY=QAR
SHIPPING_FLAT=50
FREE_SHIPPING_OVER=2000
# dummy bank for "Bank transfer" — replace with the real account before going live
BANK_NAME=XXX Bank
BANK_ACCOUNT_NAME=
BANK_IBAN=

# ── Seed (npm run seed) ──────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_DATA=true
